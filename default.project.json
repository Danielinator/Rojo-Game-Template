{
  "name": "Template",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "shared": {
        "$path": "src/shared"
      },
      "packages": {
        "$path": "Packages"
      },
      "components": {
        "$path": "components"
      }
    },

    "ServerScriptService": {
      "server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "client": {
          "$path": "src/client"
        },
        "$className": "StarterPlayerScripts"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "UseNewLuauTypeSolver": "Enabled"
      }
    }
  }
}