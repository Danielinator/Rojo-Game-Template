{
  "name": "Template",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Scripting": {
       "Shared": {
         "$path": "src/shared"
       },
       "Packages": {
         "$path": "Packages"
       },
       "Components": {
         "$path": "Components"
       },
       "$className": "Folder"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "$className": "StarterPlayerScripts"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "UseNewLuauTypeSolver": "Enabled"
      }
    }
  }
}